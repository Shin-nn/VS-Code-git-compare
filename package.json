{
	"name": "vs-code-git-compare",
	"displayName": "Git Compare with Ref",
	"description": "Source Control extension: compare the working tree (a folder, or one file) with any branch, tag or commit, inline or side by side.",
	"version": "0.1.1",
	"publisher": "cernik",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "https://github.com/Shin-nn/vs-code-git-compare.git"
	},
	"engines": {
		"vscode": "^1.86.0"
	},
	"categories": [
		"SCM Providers",
		"Other"
	],
	"keywords": [
		"git",
		"diff",
		"compare",
		"branch",
		"commit"
	],
	"main": "./out/extension.js",
	"extensionKind": [
		"workspace"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"scripts": {
		"compile": "tsc -p .",
		"watch": "tsc -watch -p .",
		"typecheck": "tsc -p . --noEmit",
		"package": "npm run compile && vsce package --no-dependencies"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@types/vscode": "~1.86.0",
		"@vscode/vsce": "^3.9.2",
		"typescript": "^5.6.0"
	},
	"contributes": {
		"views": {
			"scm": [
				{
					"id": "gitCompare.view",
					"name": "Compare with Ref",
					"icon": "$(git-compare)"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "gitCompare.view",
				"contents": "Compare the working tree with a branch, tag or commit.\n[Compare with Branch, Tag or Commit…](command:gitCompare.compareWithRef)\n[Compare with Merge Base…](command:gitCompare.compareWithMergeBase)\nMerge base: only the changes made since the branch split off from the one you pick.",
				"when": "!gitCompare.active"
			}
		],
		"commands": [
			{
				"command": "gitCompare.compareWithRef",
				"title": "Compare Working Tree with Branch, Tag or Commit…",
				"shortTitle": "Compare with Ref…",
				"category": "Git Compare",
				"icon": "$(git-compare)"
			},
			{
				"command": "gitCompare.compareWithMergeBase",
				"title": "Compare Working Tree with Merge Base…",
				"shortTitle": "Compare with Merge Base…",
				"category": "Git Compare",
				"icon": "$(git-merge)"
			},
			{
				"command": "gitCompare.compareResourceWithRef",
				"title": "Compare with Branch, Tag or Commit…",
				"category": "Git Compare",
				"icon": "$(git-compare)"
			},
			{
				"command": "gitCompare.openActiveFileDiff",
				"title": "Compare Active File with the Current Compare Base",
				"category": "Git Compare",
				"icon": "$(git-compare)",
				"enablement": "gitCompare.active"
			},
			{
				"command": "gitCompare.checkForUpdates",
				"title": "Check for Updates…",
				"category": "Git Compare"
			},
			{
				"command": "gitCompare.refresh",
				"title": "Refresh",
				"category": "Git Compare",
				"icon": "$(refresh)"
			},
			{
				"command": "gitCompare.clear",
				"title": "Close Comparison",
				"category": "Git Compare",
				"icon": "$(close)"
			},
			{
				"command": "gitCompare.openAll",
				"title": "Open All Changes",
				"category": "Git Compare",
				"icon": "$(diff-multiple)"
			},
			{
				"command": "gitCompare.showInline",
				"title": "Show Diffs Inline",
				"category": "Git Compare",
				"icon": "$(diff-single)"
			},
			{
				"command": "gitCompare.showSideBySide",
				"title": "Show Diffs Side by Side",
				"category": "Git Compare",
				"icon": "$(split-horizontal)"
			},
			{
				"command": "gitCompare.viewAsTree",
				"title": "View as Tree",
				"category": "Git Compare",
				"icon": "$(list-tree)"
			},
			{
				"command": "gitCompare.viewAsList",
				"title": "View as List",
				"category": "Git Compare",
				"icon": "$(list-flat)"
			},
			{
				"command": "gitCompare.openDiff",
				"title": "Open Changes",
				"category": "Git Compare",
				"icon": "$(diff)"
			},
			{
				"command": "gitCompare.openDiffInline",
				"title": "Open Changes Inline",
				"category": "Git Compare",
				"icon": "$(diff-single)"
			},
			{
				"command": "gitCompare.openDiffSideBySide",
				"title": "Open Changes Side by Side",
				"category": "Git Compare",
				"icon": "$(split-horizontal)"
			},
			{
				"command": "gitCompare.openFile",
				"title": "Open File",
				"category": "Git Compare",
				"icon": "$(go-to-file)"
			},
			{
				"command": "gitCompare.openFileAtRef",
				"title": "Open File at Compare Base",
				"category": "Git Compare",
				"icon": "$(file-symlink-file)"
			}
		],
		"menus": {
			"commandPalette": [
				{ "command": "gitCompare.compareResourceWithRef", "when": "resourceScheme == file" },
				{ "command": "gitCompare.refresh", "when": "gitCompare.active" },
				{ "command": "gitCompare.clear", "when": "gitCompare.active" },
				{ "command": "gitCompare.openAll", "when": "gitCompare.active" },
				{ "command": "gitCompare.viewAsTree", "when": "false" },
				{ "command": "gitCompare.viewAsList", "when": "false" },
				{ "command": "gitCompare.openDiff", "when": "false" },
				{ "command": "gitCompare.openDiffInline", "when": "false" },
				{ "command": "gitCompare.openDiffSideBySide", "when": "false" },
				{ "command": "gitCompare.openFile", "when": "false" },
				{ "command": "gitCompare.openFileAtRef", "when": "false" }
			],
			"view/title": [
				{ "command": "gitCompare.compareWithRef", "when": "view == gitCompare.view", "group": "navigation@1" },
				{ "command": "gitCompare.openAll", "when": "view == gitCompare.view && gitCompare.active", "group": "navigation@2" },
				{ "command": "gitCompare.showInline", "when": "view == gitCompare.view && gitCompare.sideBySide", "group": "navigation@3" },
				{ "command": "gitCompare.showSideBySide", "when": "view == gitCompare.view && !gitCompare.sideBySide", "group": "navigation@3" },
				{ "command": "gitCompare.refresh", "when": "view == gitCompare.view && gitCompare.active", "group": "navigation@4" },
				{ "command": "gitCompare.clear", "when": "view == gitCompare.view && gitCompare.active", "group": "navigation@5" },
				{ "command": "gitCompare.compareWithMergeBase", "when": "view == gitCompare.view", "group": "1_compare@1" },
				{ "command": "gitCompare.viewAsTree", "when": "view == gitCompare.view && !gitCompare.viewAsTree", "group": "2_view@1" },
				{ "command": "gitCompare.viewAsList", "when": "view == gitCompare.view && gitCompare.viewAsTree", "group": "2_view@1" }
			],
			"view/item/context": [
				{ "command": "gitCompare.openDiffInline", "when": "view == gitCompare.view && viewItem =~ /^file/", "group": "inline@1" },
				{ "command": "gitCompare.openDiffSideBySide", "when": "view == gitCompare.view && viewItem =~ /^file/", "group": "inline@2" },
				{ "command": "gitCompare.openFile", "when": "view == gitCompare.view && viewItem =~ /^file/ && viewItem != fileDeleted", "group": "inline@3" },
				{ "command": "gitCompare.openDiffInline", "when": "view == gitCompare.view && viewItem =~ /^file/", "group": "1_open@1" },
				{ "command": "gitCompare.openDiffSideBySide", "when": "view == gitCompare.view && viewItem =~ /^file/", "group": "1_open@2" },
				{ "command": "gitCompare.openFile", "when": "view == gitCompare.view && viewItem =~ /^file/ && viewItem != fileDeleted", "group": "1_open@3" },
				{ "command": "gitCompare.openFileAtRef", "when": "view == gitCompare.view && viewItem =~ /^file/ && viewItem != fileAdded", "group": "1_open@4" },
				{ "command": "gitCompare.openAll", "when": "view == gitCompare.view && viewItem =~ /^group/", "group": "inline@1" },
				{ "command": "gitCompare.openAll", "when": "view == gitCompare.view && viewItem =~ /^group/", "group": "1_open@1" }
			],
			"scm/title": [
				{ "command": "gitCompare.compareWithRef", "when": "scmProvider == git", "group": "8_compare@1" },
				{ "command": "gitCompare.compareWithMergeBase", "when": "scmProvider == git", "group": "8_compare@2" }
			],
			"explorer/context": [
				{ "command": "gitCompare.compareResourceWithRef", "when": "resourceScheme == file", "group": "3_compare@9" }
			],
			"editor/title/context": [
				{ "command": "gitCompare.compareResourceWithRef", "when": "resourceScheme == file", "group": "3_compare@9" },
				{ "command": "gitCompare.openActiveFileDiff", "when": "resourceScheme == file && gitCompare.active", "group": "3_compare@10" }
			],
			"editor/context": [
				{ "command": "gitCompare.compareResourceWithRef", "when": "resourceScheme == file", "group": "9_compare@1" }
			]
		},
		"configuration": {
			"title": "Git Compare",
			"properties": {
				"gitCompare.diffLayout": {
					"type": "string",
					"enum": ["keep", "sideBySide", "inline"],
					"enumDescriptions": [
						"Open diffs the way VS Code currently shows them (diffEditor.renderSideBySide).",
						"Always open diffs side by side.",
						"Always open diffs inline."
					],
					"default": "keep",
					"description": "How a click on a file opens its diff. The Inline / Side by Side buttons switch diffEditor.renderSideBySide, as VS Code's own 'Toggle Inline View' does."
				},
				"gitCompare.forceSideBySide": {
					"type": "boolean",
					"default": true,
					"description": "When a diff is asked for side by side, also turn off diffEditor.useInlineViewWhenSpaceIsLimited, so that a narrow editor doesn't fall back to inline."
				},
				"gitCompare.viewAsTree": {
					"type": "boolean",
					"default": true,
					"description": "Show the changed files as a folder tree (otherwise as a flat list)."
				},
				"gitCompare.showUntracked": {
					"type": "boolean",
					"default": true,
					"description": "List untracked (not ignored) files, in their own collapsed group."
				},
				"gitCompare.autoRefresh": {
					"type": "boolean",
					"default": true,
					"description": "Refresh the comparison when files in the repository change."
				},
				"gitCompare.recentCommits": {
					"type": "number",
					"default": 200,
					"minimum": 0,
					"description": "How many commits of HEAD's history the ref picker offers."
				},
				"gitCompare.checkForUpdates": {
					"type": "boolean",
					"default": true,
					"description": "Once a day, check the GitHub releases of this extension for a newer version and offer to install it."
				},
				"gitCompare.previewEditors": {
					"type": "boolean",
					"default": true,
					"description": "Open diffs from the view as preview editors (replaced by the next one, as in Source Control)."
				}
			}
		}
	}
}
